menu "Scorbot"

    choice SCORBOT_DRIVER
        prompt "Motor driver carriers"
        default SCORBOT_DRIVER_CGW
        help
            All six carriers must be the same type. Sets the current-sense
            scaling, the driver's current limit and the default software trip.

        config SCORBOT_DRIVER_CGW
            bool "DRV8874, hardware/drv8874-carrier (2.4k CS: 1.08 V/A, ~3.1 A)"
        config SCORBOT_DRIVER_POLOLU_4035
            bool "DRV8874, Pololu #4035 (2.49k CS: 1.12 V/A, ~2.9 A)"
        config SCORBOT_DRIVER_POLOLU_4036
            bool "DRV8876, Pololu #4036 (2.49 V/A, ~1.33 A, 1.2 A trip)"
    endchoice

endmenu
